set(serial_prefix "@CMAKE_CURRENT_BINARY_DIR@/consumer-prefix")
set(serial_consumer_build "@CMAKE_CURRENT_BINARY_DIR@/consumer-build")

execute_process(
  COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --prefix "${serial_prefix}"
  RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "serial installation failed")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@"
    -S "@CMAKE_CURRENT_SOURCE_DIR@/tests/consumer"
    -B "${serial_consumer_build}"
    "-DCMAKE_PREFIX_PATH=${serial_prefix}"
  RESULT_VARIABLE configure_result
)
if(NOT configure_result EQUAL 0)
  message(FATAL_ERROR "serial consumer configuration failed")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@" --build "${serial_consumer_build}"
  RESULT_VARIABLE build_result
)
if(NOT build_result EQUAL 0)
  message(FATAL_ERROR "serial consumer build failed")
endif()
