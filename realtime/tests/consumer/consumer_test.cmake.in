set(realtime_prefix "@CMAKE_CURRENT_BINARY_DIR@/consumer-prefix")
set(realtime_consumer_build "@CMAKE_CURRENT_BINARY_DIR@/consumer-build")

execute_process(
  COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --prefix "${realtime_prefix}"
  RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "realtime installation failed")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@"
    -S "@CMAKE_CURRENT_SOURCE_DIR@/tests/consumer"
    -B "${realtime_consumer_build}"
    "-DCMAKE_PREFIX_PATH=${realtime_prefix}"
  RESULT_VARIABLE configure_result
)
if(NOT configure_result EQUAL 0)
  message(FATAL_ERROR "realtime consumer configuration failed")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@" --build "${realtime_consumer_build}"
  RESULT_VARIABLE build_result
)
if(NOT build_result EQUAL 0)
  message(FATAL_ERROR "realtime consumer build failed")
endif()

execute_process(
  COMMAND "${realtime_consumer_build}/realtime_consumer"
  RESULT_VARIABLE run_result
)
if(NOT run_result EQUAL 0)
  message(FATAL_ERROR "realtime consumer failed")
endif()
